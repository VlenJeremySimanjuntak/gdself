{
  "info": {
    "name": "Go Template JWT Tests",
    "_postman_id": "jwt-collection",
    "description": "Requests to test login (token issuance) and protected endpoints",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Register User",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nama\": \"Budi\",\n  \"email\": \"budi@example.com\",\n  \"password\": \"secret123\",\n  \"jenis_kelamin\": \"L\"\n}"
        },
        "url": {
          "raw": "http://localhost:3000/api/users",
          "protocol": "http",
          "host": [ "localhost" ],
          "port": "3000",
          "path": [ "api", "users" ]
        }
      }
    },
    {
      "name": "Login (get JWT)",
      "request": {
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"budi@example.com\",\n  \"password\": \"secret123\"\n}"
        },
        "url": {
          "raw": "http://localhost:3000/api/login",
          "protocol": "http",
          "host": [ "localhost" ],
          "port": "3000",
          "path": [ "api", "login" ]
        }
      }
    },
    {
      "name": "Get All Users (Protected)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{jwt}}" }
        ],
        "url": {
          "raw": "http://localhost:3000/api/users",
          "protocol": "http",
          "host": [ "localhost" ],
          "port": "3000",
          "path": [ "api", "users" ]
        }
      }
    }
  ],
  "variable": [
    { "key": "jwt", "value": "" }
  ]
}
