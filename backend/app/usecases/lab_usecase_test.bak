package usecases

import (
	"testing"
	"monitoring-service/app/models"
)


func buatParams(tsh, ft3, ft4, trab float64) []models.AssessmentParamInput {
	return []models.AssessmentParamInput{
		{NamaParameter: "TSH", NilaiHasil: tsh, NilaiBatasBawah: 0.4, NilaiBatasAtas: 4.0},
		{NamaParameter: "FT3", NilaiHasil: ft3, NilaiBatasBawah: 2.0, NilaiBatasAtas: 4.2},
		{NamaParameter: "FT4", NilaiHasil: ft4, NilaiBatasBawah: 9.0, NilaiBatasAtas: 15.0},
		{NamaParameter: "TRAb", NilaiHasil: trab, NilaiBatasBawah: 0.0, NilaiBatasAtas: 1.75},
	}
}

// ==========================================
// 2. TEST LAPIS KEAMANAN (ANTI-TREMOR)
// ==========================================
func TestAnalyzeLabResults_LapisKeamananTremor(t *testing.T) {
	t.Run("Kasus 1: Data Normal Harus Lolos", func(t *testing.T) {
		params := buatParams(1.5, 3.0, 12.0, 1.0)
		res := AnalyzeLabResults(params)
		
		if res.StatusTSH == "Perlu Verifikasi" {
			t.Errorf("GAGAL: data normal malah ditandai Perlu Verifikasi")
		}
	})

	t.Run("Kasus 2: Deteksi Tremor Desimal 135.0", func(t *testing.T) {
		// Batas atas TSH adalah 4.0. Menurut kode Mas, > (4.0 * 10) = 40.0 akan ditolak
		params := []models.AssessmentParamInput{
			{NamaParameter: "TSH", NilaiHasil: 135.0, NilaiBatasBawah: 0.4, NilaiBatasAtas: 4.0},
		}
		res := AnalyzeLabResults(params)
		
		if res.StatusTSH != "Perlu Verifikasi" {
			t.Errorf("GAGAL: angka absurd 135.0 seharusnya terdeteksi (karena > 40.0), didapat %q", res.StatusTSH)
		}
	})

	t.Run("Kasus 3: Deteksi Batas Acuan Terbalik", func(t *testing.T) {
		// Batas Bawah (4.0) >= Batas Atas (0.4)
		params := []models.AssessmentParamInput{
			{NamaParameter: "TSH", NilaiHasil: 2.0, NilaiBatasBawah: 4.0, NilaiBatasAtas: 0.4},
		}
		res := AnalyzeLabResults(params)
		
		if res.StatusTSH != "Perlu Verifikasi" {
			t.Errorf("GAGAL: batas acuan terbalik seharusnya terdeteksi, didapat %q", res.StatusTSH)
		}
	})
}

// ==========================================
// 3. TEST INTERPRETASI KESELURUHAN (RULE BASE)
// ==========================================
func TestAnalyzeLabResults_Normal(t *testing.T) {
	// Semua dalam rentang normal
	params := buatParams(1.5, 3.0, 12.0, 0.5)
	res := AnalyzeLabResults(params)

	if res.Interpretasi != "Normal" {
		t.Errorf("Interpretasi: diharapkan \"Normal\", didapat %q", res.Interpretasi)
	}
}

func TestAnalyzeLabResults_BelumNormal(t *testing.T) {
	// TSH Rendah (<0.4), FT3 Tinggi (>4.2), FT4 Tinggi (>15.0)
	params := buatParams(0.1, 5.0, 16.0, 1.0)
	res := AnalyzeLabResults(params)

	if res.Interpretasi != "Belum Normal" {
		t.Errorf("Interpretasi: diharapkan \"Belum Normal\", didapat %q", res.Interpretasi)
	}
}

func TestAnalyzeLabResults_PolaBelumSesuai(t *testing.T) {
	// TSH Normal tapi FT4 Tinggi -> Tidak masuk Aturan 1 maupun Aturan 2-5
	params := buatParams(2.0, 3.0, 16.0, 1.0)
	res := AnalyzeLabResults(params)

	expected := "Pola Hormon Belum Sesuai Graves Disease"
	if res.Interpretasi != expected {
		t.Errorf("Interpretasi: diharapkan %q, didapat %q", expected, res.Interpretasi)
	}
}

// ==========================================
// 4. TEST ANALISIS TREN HISTORIS
// ==========================================
func TestAnalyzeTren_MendekatiNormal(t *testing.T) {
	prev := LabAssessmentResult{NilaiTSH: 0.1, StatusTSH: "Rendah"}
	curr := LabAssessmentResult{NilaiTSH: 1.5, StatusTSH: "Normal"}
	
	tren := AnalyzeTren(prev, curr)

	if tren.TrenTSH != "Mendekati normal" {
		t.Errorf("TrenTSH: diharapkan \"Mendekati normal\", didapat %q", tren.TrenTSH)
	}
}

func TestAnalyzeTren_MenjauhiNormal(t *testing.T) {
	prev := LabAssessmentResult{NilaiFT3: 3.0, StatusFT3: "Normal"}
	curr := LabAssessmentResult{NilaiFT3: 5.0, StatusFT3: "Tinggi"}
	
	tren := AnalyzeTren(prev, curr)

	if tren.TrenFT3 != "Menjauhi normal" {
		t.Errorf("TrenFT3: diharapkan \"Menjauhi normal\", didapat %q", tren.TrenFT3)
	}
}

func TestAnalyzeTren_TetapNegatif_TRAb(t *testing.T) {
	prev := LabAssessmentResult{NilaiTRAb: 0.5, StatusTRAb: "Negatif"}
	curr := LabAssessmentResult{NilaiTRAb: 1.0, StatusTRAb: "Negatif"}
	
	tren := AnalyzeTren(prev, curr)

	// Kode Mas membedakan kalimat berdasarkan naik/turun, tapi status tren-nya tetap "Tetap normal"
	if tren.TrenTRAb != "Tetap normal" {
		t.Errorf("TrenTRAb: diharapkan \"Tetap normal\", didapat %q", tren.TrenTRAb)
	}
}