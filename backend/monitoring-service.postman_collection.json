{
  "info": {
    "name": "GdSelf API - Graves Disease Monitoring",
    "description": "Collection lengkap untuk GdSelf Backend. Flow: Register → Riwayat → Laporan Lab → Hasil Lab → Assess (Mesin 1/3) | Wearable → Hasil AI Harian (Mesin 2)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:3000/api", "type": "string" },
    { "key": "auth_token", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nama\": \"Irene Situmorang\",\n  \"email\": \"irene@gmail.com\",\n  \"password\": \"password123\",\n  \"jenis_kelamin\": \"P\",\n  \"tgl_lahir\": \"1995-03-20\",\n  \"tgl_terdiagnosis\": \"2023-06-01\"\n}"
            },
            "url": { "raw": "{{base_url}}/auth/register" }
          }
        },
        {
          "name": "Login User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"irene@gmail.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": { "raw": "{{base_url}}/auth/login" }
          }
        },
        {
          "name": "Google Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id_token\": \"google-id-token-here\"\n}"
            },
            "url": { "raw": "{{base_url}}/auth/google" }
          }
        }
      ]
    },
    {
      "name": "2. User Management",
      "item": [
        {
          "name": "Get All Users",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{auth_token}}" }],
            "url": { "raw": "{{base_url}}/users" }
          }
        },
        {
          "name": "Get User by ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{auth_token}}" }],
            "url": { "raw": "{{base_url}}/users/1" }
          }
        },
        {
          "name": "Update User",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nama\": \"Irene Situmorang Updated\",\n  \"jenis_kelamin\": \"P\",\n  \"tgl_lahir\": \"1995-03-20\",\n  \"tgl_terdiagnosis\": \"2023-06-01\"\n}"
            },
            "url": { "raw": "{{base_url}}/users/1" }
          }
        },
        {
          "name": "Delete User",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{auth_token}}" }],
            "url": { "raw": "{{base_url}}/users/1" }
          }
        }
      ]
    },
    {
      "name": "3. Riwayat (Session Anchor)",
      "description": "Riwayat adalah tabel anchor. Semua data (wearable, laporan lab, USG) terhubung ke riwayat. Buat riwayat dulu sebelum input data lain.",
      "item": [
        {
          "name": "Create Riwayat",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id_user\": 1,\n  \"tanggal\": \"2024-01-15\"\n}"
            },
            "url": { "raw": "{{base_url}}/riwayat" }
          }
        },
        {
          "name": "Get All Riwayat",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{auth_token}}" }],
            "url": { "raw": "{{base_url}}/riwayat" }
          }
        },
        {
          "name": "Get Riwayat by ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{auth_token}}" }],
            "url": { "raw": "{{base_url}}/riwayat/1" }
          }
        },
        {
          "name": "Get Riwayat by User ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{auth_token}}" }],
            "url": { "raw": "{{base_url}}/riwayat/user/1" }
          }
        },
        {
          "name": "Update Riwayat",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tanggal\": \"2024-01-20\"\n}"
            },
            "url": { "raw": "{{base_url}}/riwayat/1" }
          }
        },
        {
          "name": "Delete Riwayat",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{auth_token}}" }],
            "url": { "raw": "{{base_url}}/riwayat/1" }
          }
        }
      ]
    },
    {
      "name": "4. Wearable + Mesin 2 (Non-Lab Day)",
      "description": "Mesin 2: POST /wearable akan otomatis trigger rule-based AI untuk HR dan tidur. Hasilnya tersimpan di hasil_ai_harian.",
      "item": [
        {
          "name": "⚡ Create Wearable (Auto-trigger Mesin 2)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id_user\": 1,\n  \"id_riwayat\": 1,\n  \"tgl_data\": \"2024-01-15\",\n  \"heart_rate_hr\": 105,\n  \"sleep_duration\": 300\n}"
            },
            "url": {
              "raw": "{{base_url}}/wearable",
              "description": "Setelah wearable disimpan, Mesin 2 otomatis jalan dan menyimpan hasil ke hasil_ai_harian. heart_rate_hr tinggi (>100) = status HR Tinggi. sleep_duration 300 menit (5 jam) = tidur kurang."
            }
          }
        },
        {
          "name": "Create Wearable (HR Normal)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id_user\": 1,\n  \"id_riwayat\": 1,\n  \"tgl_data\": \"2024-01-16\",\n  \"heart_rate_hr\": 72,\n  \"sleep_duration\": 420\n}"
            },
            "url": { "raw": "{{base_url}}/wearable" }
          }
        },
        {
          "name": "Get All Wearable",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{auth_token}}" }],
            "url": { "raw": "{{base_url}}/wearable" }
          }
        },
        {
          "name": "Get Wearable by ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{auth_token}}" }],
            "url": { "raw": "{{base_url}}/wearable/1" }
          }
        },
        {
          "name": "Get Wearable by Riwayat ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{auth_token}}" }],
            "url": { "raw": "{{base_url}}/wearable/riwayat/1" }
          }
        },
        {
          "name": "Get Wearable by User ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{auth_token}}" }],
            "url": { "raw": "{{base_url}}/wearable/user/1" }
          }
        },
        {
          "name": "Update Wearable",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"heart_rate_hr\": 88,\n  \"sleep_duration\": 450\n}"
            },
            "url": { "raw": "{{base_url}}/wearable/1" }
          }
        },
        {
          "name": "Delete Wearable",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{auth_token}}" }],
            "url": { "raw": "{{base_url}}/wearable/1" }
          }
        }
      ]
    },
    {
      "name": "5. Laporan Lab",
      "description": "Cukup kirim id_user dan nama_lab. Backend otomatis buat/cari riwayat hari ini untuk user tersebut.",
      "item": [
        {
          "name": "Create Laporan Lab (kirim id_user)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id_user\": 1,\n  \"nama_lab\": \"Prodia Pematang Siantar\",\n  \"tgl_periksa\": \"2024-01-15\"\n}"
            },
            "url": { "raw": "{{base_url}}/laporan-lab" }
          }
        },
        {
          "name": "Create Laporan Lab (kirim id_riwayat langsung)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id_riwayat\": 1,\n  \"nama_lab\": \"Prodia Pematang Siantar\",\n  \"tgl_periksa\": \"2024-01-15\"\n}"
            },
            "url": { "raw": "{{base_url}}/laporan-lab" }
          }
        },
        {
          "name": "Get All Laporan Lab",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{auth_token}}" }],
            "url": { "raw": "{{base_url}}/laporan-lab" }
          }
        },
        {
          "name": "Get Laporan Lab by ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{auth_token}}" }],
            "url": { "raw": "{{base_url}}/laporan-lab/1" }
          }
        },
        {
          "name": "Get Laporan Lab by User ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{auth_token}}" }],
            "url": { "raw": "{{base_url}}/laporan-lab/user/1" }
          }
        },
        {
          "name": "Update Laporan Lab",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nama_lab\": \"Kimia Farma\",\n  \"tgl_periksa\": \"2024-01-20\"\n}"
            },
            "url": { "raw": "{{base_url}}/laporan-lab/1" }
          }
        },
        {
          "name": "Delete Laporan Lab",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{auth_token}}" }],
            "url": { "raw": "{{base_url}}/laporan-lab/1" }
          }
        }
      ]
    },
    {
      "name": "6. Hasil Lab (Input Parameter)",
      "description": "Simpan nilai TSH, FT3, FT4 ke laporan lab. Ini data mentah sebelum di-assess AI.",
      "item": [
        {
          "name": "Create Hasil Lab (TSH+FT3+FT4)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id_laporan_lab\": 1,\n  \"parameters\": [\n    {\n      \"nama_parameter\": \"TSH\",\n      \"nilai_hasil\": 0.01,\n      \"nilai_batas_bawah\": 0.4,\n      \"nilai_batas_atas\": 4.0,\n      \"satuan\": \"mIU/L\",\n      \"kategori\": \"Tiroid\"\n    },\n    {\n      \"nama_parameter\": \"FT3\",\n      \"nilai_hasil\": 8.5,\n      \"nilai_batas_bawah\": 2.0,\n      \"nilai_batas_atas\": 4.4,\n      \"satuan\": \"pg/mL\",\n      \"kategori\": \"Tiroid\"\n    },\n    {\n      \"nama_parameter\": \"FT4\",\n      \"nilai_hasil\": 3.2,\n      \"nilai_batas_bawah\": 0.9,\n      \"nilai_batas_atas\": 1.7,\n      \"satuan\": \"ng/dL\",\n      \"kategori\": \"Tiroid\"\n    }\n  ]\n}"
            },
            "url": { "raw": "{{base_url}}/hasil-lab" }
          }
        },
        {
          "name": "Create Hasil Lab (Normal - untuk test Mesin 3)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id_laporan_lab\": 2,\n  \"parameters\": [\n    {\n      \"nama_parameter\": \"TSH\",\n      \"nilai_hasil\": 1.5,\n      \"nilai_batas_bawah\": 0.4,\n      \"nilai_batas_atas\": 4.0,\n      \"satuan\": \"mIU/L\",\n      \"kategori\": \"Tiroid\"\n    },\n    {\n      \"nama_parameter\": \"FT3\",\n      \"nilai_hasil\": 3.2,\n      \"nilai_batas_bawah\": 2.0,\n      \"nilai_batas_atas\": 4.4,\n      \"satuan\": \"pg/mL\",\n      \"kategori\": \"Tiroid\"\n    },\n    {\n      \"nama_parameter\": \"FT4\",\n      \"nilai_hasil\": 1.2,\n      \"nilai_batas_bawah\": 0.9,\n      \"nilai_batas_atas\": 1.7,\n      \"satuan\": \"ng/dL\",\n      \"kategori\": \"Tiroid\"\n    }\n  ]\n}"
            },
            "url": { "raw": "{{base_url}}/hasil-lab" }
          }
        },
        {
          "name": "Get All Hasil Lab",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{auth_token}}" }],
            "url": { "raw": "{{base_url}}/hasil-lab" }
          }
        },
        {
          "name": "Get Hasil Lab by ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{auth_token}}" }],
            "url": { "raw": "{{base_url}}/hasil-lab/1" }
          }
        },
        {
          "name": "Get Hasil Lab by Laporan ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{auth_token}}" }],
            "url": { "raw": "{{base_url}}/hasil-lab/laporan/1" }
          }
        },
        {
          "name": "Get Hasil Lab by Riwayat ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{auth_token}}" }],
            "url": { "raw": "{{base_url}}/hasil-lab/riwayat/1" }
          }
        },
        {
          "name": "Update Hasil Lab",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nilai_hasil\": 0.02,\n  \"nilai_batas_bawah\": 0.4,\n  \"nilai_batas_atas\": 4.0\n}"
            },
            "url": { "raw": "{{base_url}}/hasil-lab/1" }
          }
        },
        {
          "name": "Delete Hasil Lab",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{auth_token}}" }],
            "url": { "raw": "{{base_url}}/hasil-lab/1" }
          }
        }
      ]
    },
    {
      "name": "7. Hasil AI",
      "description": "Mesin 1: assess tanpa prev_lab. Mesin 3: assess dengan prev_lab. Mesin 2: otomatis saat POST /wearable.",
      "item": [
        {
          "name": "⚡ Mesin 1 - Assess Lab Day (Tidak Ada Data Sebelumnya)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"lab\": {\n    \"id_laporan_lab\": 1,\n    \"parameters\": [\n      {\n        \"nama_parameter\": \"TSH\",\n        \"nilai_hasil\": 0.01,\n        \"nilai_batas_bawah\": 0.4,\n        \"nilai_batas_atas\": 4.0\n      },\n      {\n        \"nama_parameter\": \"FT3\",\n        \"nilai_hasil\": 8.5,\n        \"nilai_batas_bawah\": 2.0,\n        \"nilai_batas_atas\": 4.4\n      },\n      {\n        \"nama_parameter\": \"FT4\",\n        \"nilai_hasil\": 3.2,\n        \"nilai_batas_bawah\": 0.9,\n        \"nilai_batas_atas\": 1.7\n      }\n    ]\n  },\n  \"prev_lab\": null,\n  \"is_lab_day\": true\n}"
            },
            "url": {
              "raw": "{{base_url}}/hasil-ai/assess",
              "description": "Mesin 1: TSH rendah (0.01), FT3 tinggi (8.5), FT4 tinggi (3.2) → Overt Graves Disease. prev_lab null karena tidak ada data sebelumnya. Hasil disimpan ke hasil_ai_lab."
            }
          }
        },
        {
          "name": "⚡ Mesin 3 - Assess Lab Day (Ada Data Sebelumnya = Ada Tren)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"lab\": {\n    \"id_laporan_lab\": 2,\n    \"parameters\": [\n      {\n        \"nama_parameter\": \"TSH\",\n        \"nilai_hasil\": 1.5,\n        \"nilai_batas_bawah\": 0.4,\n        \"nilai_batas_atas\": 4.0\n      },\n      {\n        \"nama_parameter\": \"FT3\",\n        \"nilai_hasil\": 3.2,\n        \"nilai_batas_bawah\": 2.0,\n        \"nilai_batas_atas\": 4.4\n      },\n      {\n        \"nama_parameter\": \"FT4\",\n        \"nilai_hasil\": 1.2,\n        \"nilai_batas_bawah\": 0.9,\n        \"nilai_batas_atas\": 1.7\n      }\n    ]\n  },\n  \"prev_lab\": {\n    \"id_laporan_lab\": 1,\n    \"parameters\": [\n      {\n        \"nama_parameter\": \"TSH\",\n        \"nilai_hasil\": 0.01,\n        \"nilai_batas_bawah\": 0.4,\n        \"nilai_batas_atas\": 4.0\n      },\n      {\n        \"nama_parameter\": \"FT3\",\n        \"nilai_hasil\": 8.5,\n        \"nilai_batas_bawah\": 2.0,\n        \"nilai_batas_atas\": 4.4\n      },\n      {\n        \"nama_parameter\": \"FT4\",\n        \"nilai_hasil\": 3.2,\n        \"nilai_batas_bawah\": 0.9,\n        \"nilai_batas_atas\": 1.7\n      }\n    ]\n  },\n  \"is_lab_day\": true\n}"
            },
            "url": {
              "raw": "{{base_url}}/hasil-ai/assess",
              "description": "Mesin 3: Lab baru (laporan 2) semua normal. Lab lama (laporan 1) semua abnormal → tren MEMBAIK. Hasil disimpan ke hasil_ai_lab DAN hasil_ai_tren."
            }
          }
        },
        {
          "name": "GET - AI Harian by ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{auth_token}}" }],
            "url": { "raw": "{{base_url}}/hasil-ai/harian/1" }
          }
        },
        {
          "name": "GET - AI Harian by Wearable ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{auth_token}}" }],
            "url": { "raw": "{{base_url}}/hasil-ai/harian/wearable/1" }
          }
        },
        {
          "name": "GET - AI Harian by Riwayat ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{auth_token}}" }],
            "url": { "raw": "{{base_url}}/hasil-ai/harian/riwayat/1" }
          }
        },
        {
          "name": "GET - AI Lab by ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{auth_token}}" }],
            "url": {
              "raw": "{{base_url}}/hasil-ai/lab/1",
              "description": "Hanya ada data setelah POST /hasil-ai/assess dengan is_lab_day: true"
            }
          }
        },
        {
          "name": "GET - AI Lab by Laporan Lab ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{auth_token}}" }],
            "url": { "raw": "{{base_url}}/hasil-ai/lab/laporan/1" }
          }
        },
        {
          "name": "GET - AI Tren by ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{auth_token}}" }],
            "url": {
              "raw": "{{base_url}}/hasil-ai/tren/1",
              "description": "Hanya ada data setelah Mesin 3 jalan (assess dengan prev_lab tidak null)"
            }
          }
        },
        {
          "name": "GET - AI Tren by Laporan Lab ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{auth_token}}" }],
            "url": {
              "raw": "{{base_url}}/hasil-ai/tren/laporan/2",
              "description": "Pakai id laporan_lab yang TERBARU (laporan 2), bukan laporan lama"
            }
          }
        },
        {
          "name": "POST - Create AI Harian Manual (opsional)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "body": {
              "mode": "raw",
